GMAIL_EMAIL=admin.medimind@gmail.com
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token

# Optional SMTP fallback for local development or non-Gmail providers.
SMTP_EMAIL=admin.medimind@gmail.com
SMTP_APP_PASSWORD=your-smtp-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587 #for local smtp use
SMTP_PORT=2525 # for render free tier hosting because its free tier blocks 587 port 
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_NAME=MediMind

# Frontend OAuth redirect target. Google OAuth must start on the backend domain
# so the backend receives the same session cookie on the callback.
VITE_GOOGLE_OAUTH_BASE_URL=https://medimind-backend-sb2z.onrender.com
